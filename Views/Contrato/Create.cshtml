@model inmobiliaria_mvc.Models.Contrato

@{
    ViewData["Title"] = "Crear Contrato";
}

<div class="mb-5">
    <a asp-action="Index" class="btn">
        <i class="fa-solid fa-arrow-left"></i>
        Volver</a>
</div>

<h1 class="h4 fw-bold">@ViewData["Title"]</h1>

<div>
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <partial name="_FormContrato" model="Model" />
        </div>
    </form>
</div>

@section Scripts {
    <script type="module" src="~/js/calendario/calendarioOcupacion.js"></script>
    <partial name="_ValidationScriptsPartial" />
}