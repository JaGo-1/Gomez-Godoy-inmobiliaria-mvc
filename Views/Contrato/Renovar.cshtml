@model inmobiliaria_mvc.Models.Contrato

@{
    ViewData["Title"] = "Renovar Contrato";
}

<div class="mb-5">
    <a asp-action="Index" class="btn">
        <i class="fa-solid fa-arrow-left"></i>
        Volver</a>
</div>

<h1 class="h4 fw-bold">@ViewData["Title"]</h1>

<div class="row g-3">
    <form asp-action="Renovar" method="post" class="container">
        <div class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="small-font">Inquilino</label>
                    <input type="text" class="form-control bg-transparent"
                        value="@($"{Model.Inquilino?.Nombre} {Model.Inquilino?.Apellido}")" disabled />
                    <input type="hidden" asp-for="IdInquilino" />
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label class="small-font">Inmueble</label>
                    <input type="text" class="form-control bg-transparent" value="@Model.Inmueble?.Direccion"
                        disabled />
                    <input type="hidden" asp-for="IdInmueble" />
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Fecha_inicio" class="control-label small-font"></label>
                    <input asp-for="Fecha_inicio" class="form-control bg-transparent" type="date" />
                    <span asp-validation-for="Fecha_inicio" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Fecha_fin" class="control-label small-font"></label>
                    <input asp-for="Fecha_fin" class="form-control bg-transparent" type="date" />
                    <span asp-validation-for="Fecha_fin" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Monto" class="control-label small-font"></label>
                    <input asp-for="Monto" class="form-control bg-transparent" type="number" step="0.01" />
                    <span asp-validation-for="Monto" class="text-danger"></span>
                </div>
            </div>

            <div class="col-12 mt-5 d-flex">
                <button type="submit" class="btn btn-primary d-flex align-items-center gap-2 px-4">
                    <i class="fa-solid fa-arrows-rotate"></i> <span>Renovar</span>
                </button>
            </div>
        </div>
    </form>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}