@model inmobiliaria_mvc.Models.Contrato

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<!-- GRID -->
<div class="col-md-6">
    <div class="form-group">
        <label asp-for="IdInquilino" class="control-label small-font"></label>
        <select asp-for="IdInquilino" class="form-control bg-transparent" asp-items="ViewBag.Inquilino">
            <option value="">-- Seleccione un inquilino --</option>
        </select>
        <span asp-validation-for="IdInquilino" class="text-danger"></span>
    </div>
</div>

<div class="col-md-6">
    <div class="form-group">
        <label asp-for="IdInmueble" class="control-label small-font"></label>
        <select asp-for="IdInmueble" id="inmueble" class="form-control bg-transparent" asp-items="ViewBag.Inmueble">
            <option value="">-- Seleccione un inmueble --</option>
        </select>
        <span asp-validation-for="IdInmueble" class="text-danger"></span>
    </div>
</div>

<div class="col-md-6">
    <div class="form-group">
        <label asp-for="Fecha_inicio" class="control-label small-font"></label>
        <input asp-for="Fecha_inicio" id="fechaInicio" class="form-control bg-transparent" type="date" />
        <span asp-validation-for="Fecha_inicio" class="text-danger"></span>
    </div>
</div>

<div class="col-md-6">
    <div class="form-group">
        <label asp-for="Fecha_fin" class="control-label small-font"></label>
        <input asp-for="Fecha_fin" id="fechaFin" class="form-control bg-transparent" type="date" />
        <span asp-validation-for="Fecha_fin" class="text-danger"></span>
    </div>
</div>

<div class="col-md-6">
    <div class="form-group">
        <label asp-for="Monto" class="control-label small-font"></label>
        <input asp-for="Monto" class="form-control bg-transparent" type="number" step="0.01" />
        <span asp-validation-for="Monto" class="text-danger"></span>
    </div>
</div>

<div class="col-12 d-flex mt-5">
    <button type="submit" class="btn btn-primary d-flex align-items-center gap-2 px-4">
        <i class="fa-regular fa-floppy-disk"></i>
        <span>Guardar</span>
    </button>
</div>