@model inmobiliaria_mvc.ViewModels.InmuebleDetalleVM

@{
    ViewData["Title"] = "Detalle del Inmueble";
}

<div class="container-fluid">
    <div class="row">

        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Detalles del Inmueble</h5>
                </div>

                <div class="card-body">
                    <h5>@Model.Inmueble.Direccion</h5>
                    <p><strong>Precio:</strong> @Model.Inmueble.Precio.ToString("C")</p>
                    <p><strong>Ambientes:</strong> @Model.Inmueble.Ambientes</p>
                    <p><strong>Uso:</strong> @Model.Inmueble.Uso</p>
                    <p><strong>Tipo:</strong> @Model.Inmueble.Tipo</p>

                    <hr />
                    <h6 class="text-muted mb-2">Portada</h6>
                    @if (!string.IsNullOrEmpty(Model.Inmueble.Portada))
                    {
                        <img src="@Model.Inmueble.Portada" alt="Portada del Inmueble"
                            class="img-fluid rounded mb-2 shadow-sm" />
                    }
                    else
                    {
                        <p><em>No hay imagen de portada</em></p>
                    }

                    <hr />
                    <h6 class="text-muted mb-2">Imágenes del Inmueble</h6>
                    <div class="d-flex flex-wrap">
                        @if (Model.Inmueble.Imagenes != null && Model.Inmueble.Imagenes.Count > 0)
                        {
                            foreach (var img in Model.Inmueble.Imagenes)
                            {
                                <div class="m-1">
                                    <img src="@img.Url" alt="Imagen del inmueble" class="img-thumbnail shadow-sm"
                                        style="width:120px; height:100px; object-fit:cover; border-radius:6px;" />
                                </div>
                            }
                        }
                        else
                        {
                            <p><em>No hay imágenes cargadas</em></p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Contratos activos</h5>
                    <a asp-controller="Contrato" asp-action="Create" asp-route-inmuebleId="@Model.Inmueble.Id"
                        class="btn btn-success">Nuevo
                        contrato</a>
                </div>

                <div class="card-body">
                    @if (Model.Contratos != null && Model.Contratos.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Inquilino</th>
                                        <th>Fecha Inicio</th>
                                        <th>Fecha Fin</th>
                                        <th>Monto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var contrato in Model.Contratos)
                                    {
                                        <tr>
                                            <td>@contrato.Inquilino?.NombreCompleto</td>
                                            <td>@contrato.Fecha_inicio.ToShortDateString()</td>
                                            <td>@contrato.Fecha_fin.ToShortDateString()</td>
                                            <td>@contrato.Monto.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No hay contratos activos para este inmueble.
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>
</div>