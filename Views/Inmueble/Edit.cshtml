@model inmobiliaria_mvc.Models.Inmueble

@{
    ViewData["Title"] = "Editar Inmueble";
}

<div class="mb-5">
    <a asp-action="Index" class="btn">
        <i class="fa-solid fa-arrow-left"></i>
        Volver</a>
</div>


<h1 class="h4 fw-bold">@ViewData["Title"]</h1>

<div>
    <form asp-action="Edit" method="post" class="">
        <div class="row g-3">
            <partial name="_FormInmueble" model="Model" />
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}