@using inmobiliaria_mvc.Models
@model inmobiliaria_mvc.Models.Inmueble

@{
	ViewData["Title"] = "Inmueble - Imágenes";
	var Id = Model?.Id ?? 0;
	/*var Id = 0;
	if(Model != null){
	Id = Model.Id;
	}*/
}
<h1 class="h4 fw-bold">Fotos del Inmueble: @Model?.Direccion</h1>
<div class="mt-5">
	<div class="d-flex flex-column gap-5">
		<div class="col-md-6">
			<h6 class="fw-bold">Foto de Portada</h6>

			@if (!string.IsNullOrEmpty(Model?.Portada))
			{
				<div class="mb-2 position-relative">
					<img src="@Model.Portada" alt="Portada" class="img-fluid rounded mb-2" />
					<form asp-controller="Inmueble" asp-action="Portada" method="post" class="d-inline">
						<input type="hidden" name="InmuebleId" value="@Id" />
						<button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash-alt"></i></button>
					</form>
				</div>
			}

			<form asp-controller="Inmueble" asp-action="Portada" method="post" enctype="multipart/form-data">
				<input type="file" id="Archivo" name="Archivo" accept="image/*" required
					class="form-control mb-2 small-font bg-transparent"
					onchange="previewImage(event, 'preview-portada', 'preview-portada-container')" />
				<input type="hidden" name="InmuebleId" value="@Id" />

				<div class="position-relative mb-2" style="display:none;" id="preview-portada-container">
					<img id="preview-portada" class="img-fluid rounded" />
					<button type="button" class="btn text-white btn-sm position-absolute" style="top:5px; right:5px;"
						onclick="cancelPreview('Archivo' ,'preview-portada', 'preview-portada-container')">
						<i class="fas fa-times"></i>
					</button>
				</div>

				<button type="submit" class="btn btn-sm btn-primary d-flex gap-3 align-items-center">
					<i class="fas fa-upload"></i>
					Subir imagen
				</button>
			</form>
		</div>


		<!-- Formulario AJAX: Imágenes interiores -->
		<div class="col-md-6">
			<h6 class="fw-bold">Imágenes del Interior</h6>

			<!-- Galería actual -->
			<div id="galeriaActual" class="d-flex flex-wrap mb-3">
				@if (Model?.Imagenes?.Count > 0)
				{
					foreach (var imagen in Model.Imagenes)
					{
						<div class="position-relative m-1" style="width: 150px; height: 150px;">
							<img src="@imagen.Url" class="img-fluid rounded"
								style="width:100%; height:100%; object-fit:cover;" />
							<button type="button" class="btn btn-danger btn-sm rounded position-absolute top-0 end-0 m-1 p-1"
								onclick="eliminarImagen(@imagen.Id)">
								<i class="fas fa-times"></i>
							</button>
						</div>
					}
				}
				else
				{
					<p class="text-muted small-font">No hay imágenes interiores disponibles.</p>
				}
			</div>

			<!-- Formulario para subir nuevas imágenes -->
			<form id="formInterior" enctype="multipart/form-data" onsubmit="subirImagenes(event)">
				<input type="file" id="imagenes" name="imagenes" accept="image/*" multiple required
					class="form-control mb-2 small-font bg-transparent" onchange="previsualizarInteriores(event)"">
				<button type=" submit" class="btn btn-sm btn-primary d-flex gap-3 align-items-center"><i
					class="fas fa-upload"></i>Subir imagen</button>
			</form>

			<!-- Previsualización -->
			<div id="preview-container" class="d-flex flex-wrap"></div>
		</div>
	</div>
</div>

@section Scripts {
	<script>

		function previsualizarInteriores(event) {
			const input = event.target;
			const previewContainer = document.getElementById('preview-container');
			previewContainer.innerHTML = ''; // limpiar previsualización

			Array.from(input.files).forEach((file, index) => {
				const reader = new FileReader();
				reader.onload = function (e) {
					const wrapper = document.createElement('div');
					wrapper.style.position = 'relative';
					wrapper.style.width = '150px';
					wrapper.style.height = '150px';
					wrapper.style.margin = '5px';

					const img = document.createElement('img');
					img.src = e.target.result;
					img.style.width = '100%';
					img.style.height = '100%';
					img.style.objectFit = 'cover';
					img.className = 'rounded';

					const btn = document.createElement('button');
					btn.type = 'button';
					btn.className = 'btn text-white btn-sm position-absolute top-0 end-0 m-1 p-1';
					btn.innerHTML = '<i class="fas fa-times"></i>';
					btn.onclick = () => {
						const dt = new DataTransfer();
						Array.from(input.files).forEach((f, i) => {
							if (i !== index) dt.items.add(f);
						});
						input.files = dt.files;
						wrapper.remove();
					};

					wrapper.appendChild(img);
					wrapper.appendChild(btn);
					previewContainer.appendChild(wrapper);
				};
				reader.readAsDataURL(file);
			});
		}
		const id = @Id; // Obtener el ID del inmueble desde el modelo

		// Función para subir imágenes por AJAX
		function subirImagenes(event) {
			event.preventDefault(); // Evitar el envío del formulario por defecto
			const files = document.querySelector('#imagenes').files;
			if (files.length === 0) {
				notyf.error("Selecciona al menos una imagen");
				return;
			}
			const formData = new FormData();
			for (let i = 0; i < files.length; i++) {
				formData.append('imagenes', files[i]);
			}

			$.ajax({
				url: `@Url.Action("Alta", "Imagenes", new { Id = Id })`,
				//url: `/Imagenes/Alta/${id}`,
				type: 'POST',
				data: formData,
				contentType: false,
				processData: false,
			}).done(function (imagenes) {
				notyf.success('Imágenes subidas con éxito');
				mostrarImagenes(imagenes);
			}).fail(function () {
				notyf.error('Error al subir las imágenes');
			}).always(function () {
				// Limpiar el formulario después de la subida
				document.getElementById('formInterior').reset();
				$('#preview').empty(); // Limpiar la previsualización
				$('#imagenes').val("");
			});
		}

		function eliminarImagen(imagenId) {
			$.post(`/Imagenes/Eliminar/${imagenId}`).done(function (imagenes) {
				notyf.success('Imagen eliminada');
				mostrarImagenes(imagenes);
			}).fail(function () {
				notyf.error('Error al eliminar la imagen');
			});
		}

		function mostrarImagenes(imagenes) {
			if (imagenes && imagenes.length > 0) {
				let html = ``;
				imagenes.forEach(img => {
					html += `																			<div class="m-2 position-relative imagen-con-hover">
								<img src="${img.url}" class="img-thumbnail" style="max-width: 150px; max-height: 150px;" />
								<button type="button" class="btn btn-danger btn-sm btn-eliminar-imagen" onclick="eliminarImagen(${img.id})">
									<i class="fas fa-times"></i>
								</button>
						</div>
						`;
				});
				$('#galeriaActual').html(html);
			} else {
				$('#galeriaActual').html('<p>No hay imágenes interiores disponibles.</p>');
			}
		}

		function previewImage(event, elementId, containerId) {
			const input = event.target;
			const preview = document.getElementById(elementId);
			const container = document.getElementById(containerId);

			if (input.files && input.files[0]) {
				const reader = new FileReader();
				reader.onload = function (e) {
					preview.src = e.target.result;
					container.style.display = 'block';
				}
				reader.readAsDataURL(input.files[0]);
			} else {
				cancelPreview();
			}
		}

		function cancelPreview(file, elementId, containerId) {
			const input = document.getElementById(file);
			const preview = document.getElementById(elementId);
			const container = document.getElementById(containerId);

			input.value = '';
			preview.src = '';
			container.style.display = 'none';
		}
	</script>

	<style>
		.imagen-con-hover {
			position: relative;
		}

		.btn-eliminar-imagen {
			position: absolute;
			top: 5px;
			right: 5px;
			display: none;
		}

		.imagen-con-hover:hover .btn-eliminar-imagen {
			display: inline-block;
		}
	</style>
}