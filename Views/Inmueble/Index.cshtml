@using inmobiliaria_mvc.ViewModels
@model TablaViewModel<Inmueble>

@{
    ViewData["Title"] = "Lista de Inmuebles";
}



@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-success">@ViewBag.Mensaje</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@{
    var termino = ViewData["Termino"] as string;
    var fechaInicio = ViewData["FechaInicio"] as DateTime?;
    var fechaFin = ViewData["FechaFin"] as DateTime?;
    var soloDisponibles = ViewData["SoloDisponibles"] as bool?;
}

<div class="d-flex align-items-en justify-content-between flex-wrap gap-3 mb-3">
    <h1 class="h4 fw-bold">@ViewData["Title"]</h1>
    <a asp-action="Create"
        class="btn border border-success text-success rounded bg-transparent d-flex align-items-center gap-2">
        <i class="fa-solid fa-plus"></i>
        Nuevo Inmueble
    </a>
</div>

<div class="row mb-3">
    <div class="col-md-3">
        <label class="small-font text-secondary">Búsqueda</label>
        <input type="text" id="filtro-termino" class="form-control bg-transparent"
            placeholder="Dirección, precio o propietario" value="@termino" />
    </div>
    <div class="col-md-3">
        <label class="small-font text-secondary">Fecha Inicio</label>
        <input type="date" id="filtro-fecha-inicio" class="form-control bg-transparent flatpick"
            value="@(fechaInicio?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-md-3">
        <label class="small-font text-secondary">Fecha Fin</label>
        <input type="date" id="filtro-fecha-fin" class="form-control bg-transparent flatpick"
            value="@(fechaFin?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-md-3">
        <label class="small-font text-secondary">Disponibilidad</label>
        <select id="filtro-disponibilidad" class="form-select bg-transparent">
            <option value="" selected="@(soloDisponibles == null)">-- Todos --</option>
            <option value="true" selected="@(soloDisponibles == true)">Disponibles</option>
            <option value="false" selected="@(soloDisponibles == false)">Ocupados</option>
        </select>
    </div>
</div>

<div id="tabla-inmueble">
    <partial name="_Tabla" model="Model" />
</div>

@section Scripts {

    <script src="~/js/tabla.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const tablaInmuebles = initTabla({
                endpoint: "/Inmueble/Filtrar",
                containerId: "tabla-inmueble",
                extraParamsFn: () => {
                    const term = document.getElementById("filtro-termino")?.value || "";
                    const fi = document.getElementById("filtro-fecha-inicio")?.value || "";
                    const ff = document.getElementById("filtro-fecha-fin")?.value || "";
                    const disp = document.getElementById("filtro-disponibilidad")?.value || "";
                    return { termino: term, fechaInicio: fi, fechaFin: ff, soloDisponibles: disp };
                }
            });

            document.getElementById("filtro-termino")?.addEventListener("input", () => tablaInmuebles.init(1));
            document.getElementById("filtro-fecha-inicio")?.addEventListener("change", () => tablaInmuebles.init(1));
            document.getElementById("filtro-fecha-fin")?.addEventListener("change", () => tablaInmuebles.init(1));
            document.getElementById("filtro-disponibilidad")?.addEventListener("change", () => tablaInmuebles.init(1));

            tablaInmuebles.init(1);
        });
    </script>
}