@model inmobiliaria_mvc.Models.Inquilino

@{
    ViewData["Title"] = "Crear Inquilino";
}

<div class="mb-5">
    <a asp-action="Index" class="btn">
        <i class="fa-solid fa-arrow-left"></i>
        Volver</a>
</div>

<h1 class="h4 fw-bold">@ViewData["Title"]</h1>

<div>
    <form asp-action="Create">
        <div class="row g-3">
            <partial name="_FormInquilino" model="Model" />
        </div>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}