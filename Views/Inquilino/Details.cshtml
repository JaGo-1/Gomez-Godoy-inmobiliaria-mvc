@model inmobiliaria_mvc.ViewModels.InquilinoDetalleVM

@{
    ViewData["Title"] = "Detalles del Inquilino";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Detalles del Inquilino</h5>
                </div>
                <div class="card-body">
                    <p><strong>Nombre:</strong> @Model.Inquilino?.Nombre</p>
                    <p><strong>Apellido:</strong> @Model.Inquilino?.Apellido</p>
                    <p><strong>DNI:</strong> @Model.Inquilino?.Dni</p>
                    <p><strong>Teléfono:</strong> @Model.Inquilino?.Telefono</p>
                    <p><strong>Email:</strong> @Model.Inquilino?.Email</p>
                </div>
            </div>
        </div>

        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Contratos Vigentes</h5>
                </div>
                <div class="card-body">
                    @if (Model.Contratos != null && Model.Contratos.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                <tr>
                                    <th>Contrato</th>
                                    <th>Inmueble</th>
                                    <th>Precio</th>
                                    <th>Fecha Inicio</th>
                                    <th>Fecha Fin</th>
                                    <th>Monto</th>
                                    <th>Terminación</th>
                                    <th>Multa</th>
                                    <th>Acciones</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var contrato in Model.Contratos)
                                {
                                    <tr>
                                        <td>@contrato.Id</td>
                                        <td>@contrato.Inmueble?.Direccion</td>
                                        <td>@contrato.Inmueble?.Precio.ToString("C")</td>
                                        <td>@contrato.Fecha_inicio.ToShortDateString()</td>
                                        <td>@contrato.Fecha_fin.ToShortDateString()</td>
                                        <td>@contrato.Monto.ToString("C")</td>
                                        <td>@(contrato.FechaTerminacionAnticipada?.ToShortDateString() ?? "-")</td>
                                        <td>@(contrato.MultaCalculada?.ToString("C") ?? "-")</td>
                                        <td>
                                            @if (contrato.FechaTerminacionAnticipada == null && contrato.Estado == EstadoContrato.Vigente)
                                            {
                                                <button type="button"
                                                        class="btn btn-danger btn-sm terminar-contrato"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#terminarContratoModal"
                                                        data-id-contrato="@contrato.Id">
                                                    <i class="fas fa-ban"></i> Anular
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Finalizado</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            Este inquilino no tiene contratos vigentes.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Pagos Asociados por Contrato</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.Mensaje != null)
                    {
                        <div class="alert alert-success">@ViewBag.Mensaje</div>
                    }
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    @if (Model.Contratos != null && Model.Contratos.Any())
                    {
                        <div class="accordion" id="accordionPagos">

                            @foreach (var contrato in Model.Contratos.OrderByDescending(c => c.Fecha_inicio))
                            {
                                var collapseId = $"collapse-{contrato.Id}";
                                var headingId = $"heading-{contrato.Id}";

                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="@headingId">
                                        <button class="accordion-button collapsed"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@collapseId"
                                                aria-expanded="false"
                                                aria-controls="@collapseId">
                                            Contrato @contrato.Id | Inmueble: @contrato.Inmueble?.Direccion
                                        </button>
                                    </h2>
                                    <div id="@collapseId"
                                         class="accordion-collapse collapse"
                                         aria-labelledby="@headingId"
                                         data-bs-parent="#accordionPagos">
                                        <div class="accordion-body">
                                            @if (contrato.Pagos != null && contrato.Pagos.Any())
                                            {
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-striped align-middle">
                                                        <thead class="table-light">
                                                        <tr>
                                                            <th>N° Pago</th>
                                                            <th>Fecha Esperada</th>
                                                            <th>Fecha Pago</th>
                                                            <th>Importe</th>
                                                            <th>Detalle</th>
                                                            <th>Estado</th>
                                                            <th>Acciones</th>
                                                        </tr>
                                                        </thead>
                                                        <tbody>
                                                        @foreach (var pago in contrato.Pagos.OrderBy(p => p.NumeroPago))
                                                        {
                                                            <tr class="@(pago.EsMulta ? "table-warning" : "")">
                                                                <td>@pago.NumeroPago</td>
                                                                <td>@pago.FechaEsperada.ToShortDateString()</td>
                                                                <td>@(pago.FechaPago.HasValue ? pago.FechaPago.Value.ToShortDateString() : "Pendiente")</td>
                                                                <td>@pago.Importe.ToString("C")</td>
                                                                <td>@pago.Detalle</td>
                                                                <td>@(pago.Estado ? "Activo" : "Anulado")</td>
                                                                <td>
                                                                    @if (pago.Estado && !pago.FechaPago.HasValue)
                                                                    {
                                                                        <form asp-controller="Pago"
                                                                              asp-action="Registrar" method="post"
                                                                              style="display:inline;">

                                                                            <input type="hidden" name="contratoId"
                                                                                   value="@contrato.Id"/>
                                                                            <input type="hidden" name="numeroPago"
                                                                                   value="@pago.NumeroPago"/>
                                                                            <input type="hidden" name="idInquilino"
                                                                                   value="@Model.Inquilino.IdInquilino"/>

                                                                            <button type="submit"
                                                                                    class="btn btn-primary btn-sm"><i
                                                                                    class="fas fa-check"></i> Registrar
                                                                                Pago
                                                                            </button>
                                                                        </form>
                                                                    }
                                                                    <a asp-controller="Pago" asp-action="Edit"
                                                                       asp-route-id="@pago.IdPago"
                                                                       class="btn btn-warning btn-sm">Editar</a>
                                                                </td>
                                                            </tr>
                                                        }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="alert alert-secondary">No hay pagos registrados para este
                                                    contrato.
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No hay contratos asociados.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>

</div>

<div class="modal fade" id="terminarContratoModal" tabindex="-1" aria-labelledby="terminarContratoModalLabel"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="terminarContratoModalLabel">Terminar Contrato</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Contrato" asp-action="TerminarAnticipado" method="post" id="terminarContratoForm">
                <div class="modal-body">
                    <input type="hidden" name="Id" id="modalContratoId" value=""/>
                    <input type="hidden" name="__RequestVerificationToken" value="@Html.AntiForgeryToken()"/>

                    <div class="form-group mb-3">
                        <label for="modalFechaTerminacionAnticipada" class="form-label fw-bold">Fecha de Terminación
                            Anticipada</label>
                        <input name="FechaTerminacionAnticipada" class="form-control" type="date"
                               id="modalFechaTerminacionAnticipada" required/>
                    </div>

                    <div class="alert alert-info p-3 border-info">
                        <h6 class="fw-bold text-info">Resumen de la Multa</h6>
                        <p class="mb-1"><strong>Meses Totales:</strong> <span id="modalTotalMeses">-</span></p>
                        <p class="mb-1"><strong>Meses Transcurridos:</strong> <span
                                id="modalMesesTranscurridos">-</span></p>
                        <p class="mb-1"><strong>Multa por:</strong> <span id="modalMultaMeses">-</span> mes(es)</p>
                        <h5 class="mt-2 text-danger">Importe Multa: <span id="modalMultaImporte"
                                                                          class="fw-bolder">-</span></h5>
                    </div>

                    <div class="form-group form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="modalPagarMultaAhora" name="pagarMultaAhora"
                               value="true"/>
                        <label class="form-check-label fw-bold" for="modalPagarMultaAhora">Pagar multa ahora</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-check-circle"></i> Confirmar</button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modal = document.getElementById('terminarContratoModal');
            const fechaInput = document.querySelector('#modalFechaTerminacionAnticipada');
            let currentContratoId = null;

            function calcularMulta(idContrato, fecha) {
                const fechaString = fecha.substring(0, 10);

                fetch(`@Url.Action("CalcularMulta", "Contrato")?id=${idContrato}&fechaTerminacion=${fechaString}`)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Error en el servidor al calcular la multa. Estado: ' + response.status);
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.error) {
                            console.error(data.error);
                            document.querySelector('#modalMultaImporte').textContent = 'Error de cálculo';
                            return;
                        }
                        document.querySelector('#modalTotalMeses').textContent = data.totalMeses;
                        document.querySelector('#modalMesesTranscurridos').textContent = data.mesesTranscurridos;
                        document.querySelector('#modalMultaMeses').textContent = data.multaMeses;

                        const multaImporteText = data.multaImporte.toLocaleString('es-AR', {
                            style: 'currency',
                            currency: 'ARS'
                        });
                        document.querySelector('#modalMultaImporte').textContent = multaImporteText;
                    })
                    .catch(error => {
                        console.error('Fetch error:', error);
                        document.querySelector('#modalMultaImporte').textContent = 'Error de conexión o cálculo';
                    });
            }

            modal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                currentContratoId = button.getAttribute('data-id-contrato');

                document.querySelector('#modalTotalMeses').textContent = '-';
                document.querySelector('#modalMesesTranscurridos').textContent = '-';
                document.querySelector('#modalMultaMeses').textContent = '-';
                document.querySelector('#modalMultaImporte').textContent = '-';
                document.querySelector('#modalPagarMultaAhora').checked = false;

                document.querySelector('#modalContratoId').value = currentContratoId;
                const today = new Date().toISOString().split('T')[0];
                fechaInput.value = today;

                calcularMulta(currentContratoId, today);
            });

            fechaInput.addEventListener('change', function () {
                const fecha = fechaInput.value;
                if (!fecha || !currentContratoId) return;
                calcularMulta(currentContratoId, fecha);
            });
        });
    </script>

}