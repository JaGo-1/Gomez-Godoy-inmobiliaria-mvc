@using inmobiliaria_mvc.ViewModels
@model TablaViewModel<Inquilino>

@{
    ViewData["Title"] = "Lista de Inquilinos";
}

<h1>@ViewData["Title"]</h1>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-success">@ViewBag.Mensaje</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@{
    var termino = ViewData["Termino"] as string;
}

<div class="row mb-3">
    <div class="col-md-6">
        <label>Búsqueda</label>
        <input type="text" id="filtro-termino" class="form-control" placeholder="DNI, nombre o email"
               value="@termino"/>
    </div>
</div>

<p>
    <a asp-action="Create" class="btn btn-success">Crear Nuevo Inquilino</a>
</p>

<div id="tabla-inquilino">
    <partial name="_Tabla" model="Model"/>
</div>

@section Scripts {
    <script src="~/js/tabla.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const tablaInquilino = initTabla({
                endpoint: "/Inquilino/Filtrar",
                containerId: "tabla-inquilino",
                extraParamsFn: () => {
                    const term = document.getElementById("filtro-termino")?.value || "";
                    return {termino: term};
                }
            });

            document.getElementById("filtro-termino")?.addEventListener("input", () => tablaInquilino.init(1));

            tablaInquilino.init(1);
        });
    </script>
}