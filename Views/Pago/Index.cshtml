@using inmobiliaria_mvc.ViewModels
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model TablaViewModel<PagoVM>


@{
    ViewData["Title"] = "Lista de Pagos";
}

<h1>@ViewData["Title"]</h1>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-success">@ViewBag.Mensaje</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@{
    var admin = (await AuthorizationService.AuthorizeAsync(User, "Administrador")).Succeeded;
}

@if (admin)
{
    <p>
        <a asp-controller="Auditoria" asp-action="Index" asp-route-tipo="pago" class="btn btn-success">
            Ver historial de cambios
        </a>
    </p>
}


<div id="tabla-pagos">
    <partial name="_Tabla" model="Model" />
</div>

@section Scripts {
    <script src="~/js/tabla.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const tablaPagos = initTabla({
                endpoint: "/Pago/Filtrar",
                containerId: "tabla-pagos"
            });

            tablaPagos.init(1);
        });
    </script>
}