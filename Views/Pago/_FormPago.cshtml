@model inmobiliaria_mvc.Models.Pago

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="col-md-4">
    <div class="form-group">
        <label asp-for="IdPago" class="control-label small-font"></label>
        <input asp-for="IdPago" class="form-control bg-transparent" readonly />
    </div>
</div>

<div class="col-md-4">
    <div class="form-group">
        <label asp-for="ContratoId" class="control-label small-font"></label>
        <input asp-for="ContratoId" class="form-control bg-transparent" readonly />
    </div>
</div>

<div class="col-md-4">
    <div class="form-group">
        <label asp-for="NumeroPago" class="control-label small-font"></label>
        <input asp-for="NumeroPago" class="form-control bg-transparent" readonly />
    </div>
</div>

<div class="col-md-6">
    <div class="form-group">
        <label asp-for="FechaPago" class="control-label small-font"></label>
        <input asp-for="FechaPago" class="form-control bg-transparent" readonly />
    </div>
</div>

<div class="col-md-6">
    <div class="form-group">
        <label asp-for="Detalle" class="control-label small-font"></label>
        <input asp-for="Detalle" class="form-control bg-transparent" />
        <span asp-validation-for="Detalle" class="text-danger"></span>
    </div>
</div>

<div class="col-12 d-flex mt-5">
    <button type="submit" class="btn btn-primary d-flex align-items-center gap-2 px-4">
        <i class="fa-regular fa-floppy-disk"></i>
        <span>Guardar</span>
    </button>
</div>