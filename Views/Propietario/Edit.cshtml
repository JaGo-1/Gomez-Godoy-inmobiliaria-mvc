@model inmobiliaria_mvc.Models.Propietario

@{
    ViewData["Title"] = "Editar Propietario";
}

<div class="mb-5">
    <a asp-action="Index" class="btn">
        <i class="fa-solid fa-arrow-left"></i>
        Volver</a>
</div>

<h1 class="h4 fw-bold">@ViewData["Title"]</h1>

<div>
    <form asp-action="Edit">
        <div class="row g-3">
            <partial name="_FormPropietario" model="Model" />
        </div>
    </form>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}