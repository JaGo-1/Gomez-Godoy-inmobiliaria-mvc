@using inmobiliaria_mvc.ViewModels
@model TablaViewModel<Propietario>

@{
    ViewData["Title"] = "Lista de Propietarios";
}

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-success">@ViewBag.Mensaje</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@{
    var termino = ViewData["Termino"] as string;
}

<div class="d-flex align-items-en justify-content-between flex-wrap gap-3 mb-3">
    <h1 class="h4 fw-bold">@ViewData["Title"]</h1>

    <div class="d-flex align-items-end gap-5 justify-content-between flex-wrap">

        <div style="width: 300px;">
            <input type="text" id="filtro-termino" class="form-control bg-transparent small-placeholder small-font"
                placeholder="Buscar por DNI, nombre o email" value="@termino" />
        </div>

        <a asp-action="Create"
            class="btn border border-success text-success rounded bg-transparent d-flex align-items-center gap-2">
            <i class="fa-solid fa-plus"></i>
            Nuevo Propietario
        </a>
    </div>
</div>


<div id="tabla-propietario">
    <partial name="_Tabla" model="Model" />
</div>

@section Scripts {
    <script src="~/js/tabla.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const tablaPropietario = initTabla({
                endpoint: "/Propietario/Filtrar",
                containerId: "tabla-propietario",
                extraParamsFn: () => {
                    const term = document.getElementById("filtro-termino")?.value || "";
                    return { termino: term };
                }
            });

            document.getElementById("filtro-termino")?.addEventListener("input", () => tablaPropietario.init(1));

            tablaPropietario.init(1);
        });
    </script>
}