@model inmobiliaria_mvc.Models.Propietario

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<!-- GRID -->
<div class="col-md-4">
    <div class="form-group">
        <label asp-for="Dni" class="control-label small-font"></label>
        <input asp-for="Dni" class="form-control bg-transparent" />
        <span asp-validation-for="Dni" class="text-danger"></span>
    </div>
</div>

<div class="col-md-4">
    <div class="form-group">
        <label asp-for="Nombre" class="control-label small-font"></label>
        <input asp-for="Nombre" class="form-control bg-transparent" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
</div>

<div class="col-md-4">
    <div class="form-group">
        <label asp-for="Apellido" class="control-label small-font"></label>
        <input asp-for="Apellido" class="form-control bg-transparent" />
        <span asp-validation-for="Apellido" class="text-danger"></span>
    </div>
</div>

<div class="col-md-6">
    <div class="form-group">
        <label asp-for="Telefono" class="control-label small-font"></label>
        <input asp-for="Telefono" class="form-control bg-transparent" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>
</div>

<div class="col-md-6">
    <div class="form-group">
        <label asp-for="Email" class="control-label small-font"></label>
        <input asp-for="Email" class="form-control bg-transparent" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
</div>

<div class="col-md-6">
    <div class="form-group">
        <label asp-for="Clave" class="control-label small-font"></label>
        <input asp-for="Clave" type="password" class="form-control bg-transparent" />
        <span asp-validation-for="Clave" class="text-danger"></span>
    </div>
</div>

<div class="col-12 d-flex mt-5">
    <button type="submit" class="btn btn-primary d-flex align-items-center gap-2 px-4">
        <i class="fa-regular fa-floppy-disk"></i>
        <span>Guardar</span>
    </button>
</div>