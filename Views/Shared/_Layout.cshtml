@using System.Security.Claims

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - inmobiliaria_mvc</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tabla.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
    <div class="sidebar">
        <nav class="position-relative d-flex flex-column h-100 p-3 ">
            <!-- Logo -->
            <div class="logo mb-8">
                <img src="~/img/text-logo.svg" alt="">
            </div>

            <!-- Enlaces principales -->
            <div class="flex-grow-1">
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Usuario" asp-action="Perfil"
                        class="d-flex align-items-center text-decoration-none gap-3 mb-4">
                        <img src="@Url.Action("Foto", "Usuario")" class="rounded-circle border" width="45" height="45"
                            style="object-fit:cover" />
                        <div>
                            <div class="email fw-bold">@User.Identity.Name</div>
                            <div class="role small">
                                @if (User.Claims.Any(c => c.Type == ClaimTypes.Role))
                                {
                                    @User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role).Value
                                }
                                else
                                {
                                    <span>(Sin Rol)</span>
                                }
                            </div>
                        </div>
                    </a>

                    <a asp-controller="Inquilino" asp-action="Index"><i
                            class="fa-solid fa-users"></i><span>Inquilinos</span></a>
                    <a asp-controller="Propietario" asp-action="Index"><i
                            class="fa-solid fa-key"></i><span>Propietarios</span></a>
                    <a asp-controller="Inmueble" asp-action="Index"><i
                            class="fa-solid fa-building"></i><span>Inmuebles</span></a>
                    <a asp-controller="Contrato" asp-action="Index"><i
                            class="fa-solid fa-file-contract"></i><span>Contratos</span></a>
                    <a asp-controller="Pago" asp-action="Index"><i class="fa-solid fa-money-bill"></i><span>Pagos</span></a>

                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-controller="Usuario" asp-action="Index"><i class="fa-solid fa-user"></i> <span>Usuario</span></a>
                        <a asp-controller="Auditoria" asp-action="Index"><i class="fa-solid fa-clipboard-list"></i>
                            <span>Auditoria</span></a>
                    }
                }
                else
                {
                    <a asp-controller="Home" asp-action="Index"><i class="fas fa-tachometer-alt"></i>
                        <span>Inicio</span></a>
                    <a asp-controller="Usuario" asp-action="Login"><i class="fa-solid fa-right-to-bracket"></i>
                        <span>Acceder</span></a>
                }
            </div>

            @if (User.Identity.IsAuthenticated)
            {
                <div class="position-absolute bottom-0 start-0 w-100 p-3">
                    <a asp-controller="Usuario" asp-action="Logout" class="d-flex align-items-center text-decoration-none ">
                        <i class="fas fa-sign-out-alt me-2"></i> Salir
                    </a>
                </div>
            }
        </nav>
    </div>

    <div class="main-container">
        <main role="main" class="main">
            @RenderBody()
        </main>
    </div>

    <partial name="_ConfirmDeleteModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>
    <script type="module">
        import { inicializarCalendarioBase } from '/js/calendario/calendarioBase.js';
        document.addEventListener("DOMContentLoaded", () => {
            inicializarCalendarioBase(".flatpick");
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/modal.js" asp-append-version="true"></script>



    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>