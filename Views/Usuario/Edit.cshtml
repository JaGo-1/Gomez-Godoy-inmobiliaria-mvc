@model inmobiliaria_mvc.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
}


<div class="mb-5">
    <a asp-action="Index" class="btn">
        <i class="fa-solid fa-arrow-left"></i>
        Volver</a>
</div>

<h1 class="h4 fw-bold">@ViewData["Title"]</h1>

<div>
    <form asp-action="Edit" enctype="multipart/form-data">
        <div class="row g-3">
            <div class="form-group mt-3">
                @if (!string.IsNullOrEmpty(Model.Avatar))
                {
                    <p>Avatar actual:</p>
                    <img src="@Model.Avatar" class="img-thumbnail mb-2" style="max-width:150px;" />
                }
                else
                {
                    <p><em>Sin avatar</em></p>
                }
            </div>
            <partial name="_FormUsuario" model="Model" />
        </div>
    </form>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}