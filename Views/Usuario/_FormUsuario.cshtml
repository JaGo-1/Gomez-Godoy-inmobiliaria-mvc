@model inmobiliaria_mvc.Models.Usuario

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="col-md-6">
    <div class="form-group">
        <label asp-for="Nombre" class="control-label small-font"></label>
        <input asp-for="Nombre" class="form-control bg-transparent" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
</div>

<div class="col-md-6">
    <div class="form-group">
        <label asp-for="Apellido" class="control-label small-font"></label>
        <input asp-for="Apellido" class="form-control bg-transparent" />
        <span asp-validation-for="Apellido" class="text-danger"></span>
    </div>
</div>

<div class="col-md-6">
    <div class="form-group">
        <label asp-for="Email" class="control-label small-font"></label>
        <input asp-for="Email" class="form-control bg-transparent" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
</div>

<div class="col-md-6">
    <div class="form-group">
        <label asp-for="Password" class="control-label small-font"></label>
        <input asp-for="Password" type="password" class="form-control bg-transparent" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
</div>

<div class="col-md-6">
    <div class="form-group">
        <label asp-for="AvatarFile" class="control-label small-font"></label>
        <input type="file" name="AvatarFile" class="form-control bg-transparent" />
        <span asp-validation-for="AvatarFile" class="text-danger"></span>
    </div>
</div>

<div class="col-md-6">
    <div class="form-group">
        <label class="control-label small-font">Rol</label>
        <select class="form-control bg-transparent" name="Rol">
            @foreach (var kvp in (IDictionary<int, string>)ViewBag.Roles)
            {
                <option value="@kvp.Key" selected="@(kvp.Key == Model.Rol)">
                    @kvp.Value
                </option>
            }
        </select>
        <span asp-validation-for="Rol" class="text-danger"></span>
    </div>
</div>

<div class="col-12 mt-3 d-flex mt-5">
    <button type="submit" class="btn btn-primary d-flex align-items-center gap-2 px-4">
        <i class="fa-regular fa-floppy-disk"></i>
        <span>Guardar</span>
    </button>
</div>